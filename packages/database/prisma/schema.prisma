generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  NURSE
  SUPER_ADMIN
  OPERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum BookingStatus {
  REQUESTED
  VERIFIED
  MATCHING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  ON_DUTY
}

enum DocumentType {
  IDENTITY
  NURSING_REGISTRATION
  CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OtpPurpose {
  PATIENT_LOGIN
  NURSE_LOGIN
  PHONE_VERIFICATION
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id                  String               @id @default(uuid())
  phone               String               @unique
  email               String?              @unique
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  phoneVerifiedAt     DateTime?
  patient             Patient?
  nurse               Nurse?
  adminPasswordHash   String?
  sessions            Session[]
  auditLogs           AuditLog[]           @relation("ActorAuditLogs")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Patient {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Nurse {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NurseDocument {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingAssignment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NurseAvailability {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpRequest {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { PATIENT NURSE SUPER_ADMIN OPERATIONS_MANAGER BOOKING_COORDINATOR NURSE_VERIFIER SUPPORT FINANCE }
enum UserStatus { ACTIVE SUSPENDED }
enum VerificationStatus { DRAFT SUBMITTED UNDER_REVIEW VERIFIED REJECTED SUSPENDED }
enum BookingStatus { REQUESTED VERIFIED MATCHING NURSE_OFFERED NURSE_ASSIGNED IN_PROGRESS COMPLETED CANCELLED }
enum AssignmentStatus { OFFERED ACCEPTED REJECTED CANCELLED COMPLETED }
enum AvailabilityStatus { AVAILABLE UNAVAILABLE BOOKED LEAVE }
enum DocumentType { IDENTITY NURSING_REGISTRATION QUALIFICATION EXPERIENCE BACKGROUND_CHECK OTHER }
enum DocumentStatus { PENDING APPROVED REJECTED EXPIRED }
enum OtpPurpose { PATIENT_LOGIN NURSE_LOGIN PHONE_VERIFICATION BOOKING_CONFIRMATION }
enum NotificationChannel { SMS WHATSAPP EMAIL PUSH }
enum NotificationStatus { QUEUED SENT FAILED }

model User {
 id String @id @default(uuid())
 phone String @unique
 email String? @unique
 role UserRole
 status UserStatus @default(ACTIVE)
 phoneVerifiedAt DateTime?
 patient Patient?
 nurse Nurse?
 adminPasswordHash String?
 sessions Session[]
 auditLogs AuditLog[] @relation("ActorAuditLogs")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Patient { id String @id @default(uuid()); userId String @unique; fullName String; city String?; address String?; emergencyContact String?; user User @relation(fields:[userId],references:[id],onDelete:Cascade); bookings Booking[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Nurse { id String @id @default(uuid()); userId String @unique; fullName String; gender String?; city String?; qualification String?; experienceYears Int?; registrationNumber String? @unique; registrationCouncil String?; verificationStatus VerificationStatus @default(DRAFT); profileStatus UserStatus @default(ACTIVE); user User @relation(fields:[userId],references:[id],onDelete:Cascade); documents NurseDocument[]; availability NurseAvailability[]; assignments BookingAssignment[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model NurseDocument { id String @id @default(uuid()); nurseId String; type DocumentType; storageKey String; status DocumentStatus @default(PENDING); expiryDate DateTime?; reviewedById String?; reviewedAt DateTime?; reviewNote String?; nurse Nurse @relation(fields:[nurseId],references:[id],onDelete:Cascade); createdAt DateTime @default(now()); @@index([nurseId,type,status]) }
model Booking { id String @id @default(uuid()); publicId String @unique; patientId String; serviceType String; city String; address String; startAt DateTime; endAt DateTime; requirement String; status BookingStatus @default(REQUESTED); cancelledAt DateTime?; completedAt DateTime?; patient Patient @relation(fields:[patientId],references:[id]); assignments BookingAssignment[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([city,startAt,endAt,status]) }
model BookingAssignment { id String @id @default(uuid()); bookingId String; nurseId String; status AssignmentStatus @default(OFFERED); assignedById String?; assignedAt DateTime @default(now()); acceptedAt DateTime?; rejectedAt DateTime?; rejectionReason String?; booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade); nurse Nurse @relation(fields:[nurseId],references:[id]); @@index([nurseId,status]); @@index([bookingId,status]) }
model NurseAvailability { id String @id @default(uuid()); nurseId String; startAt DateTime; endAt DateTime; status AvailabilityStatus; nurse Nurse @relation(fields:[nurseId],references:[id],onDelete:Cascade); @@index([nurseId,startAt,endAt]) }
model OtpRequest { id String @id @default(uuid()); phone String; purpose OtpPurpose; otpHash String; expiresAt DateTime; attemptCount Int @default(0); verifiedAt DateTime?; createdAt DateTime @default(now()); @@index([phone,purpose,createdAt]) }
model Session { id String @id @default(uuid()); userId String; secretHash String; expiresAt DateTime; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId]); @@index([expiresAt]) }
model AuditLog { id String @id @default(uuid()); actorUserId String?; action String; entityType String; entityId String; oldData Json?; newData Json?; ipAddress String?; createdAt DateTime @default(now()); actor User? @relation("ActorAuditLogs",fields:[actorUserId],references:[id]); @@index([entityType,entityId,createdAt]) }
model Notification { id String @id @default(uuid()); userId String?; channel NotificationChannel; template String; status NotificationStatus @default(QUEUED); providerId String?; sentAt DateTime?; createdAt DateTime @default(now()) }
